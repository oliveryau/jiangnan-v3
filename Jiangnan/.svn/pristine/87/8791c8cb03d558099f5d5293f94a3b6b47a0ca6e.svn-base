namespace JN.Client
{
    /// <summary>
    /// 控制是否屏蔽服务器、仅使用本地存档。
    /// </summary>
    public static class LocalSaveMode
    {
        /// <summary>
        /// 为 true 时屏蔽全部服务器请求，登录与进度只走本地存档。
        /// </summary>
        public const bool Enabled = true;

        /// <summary>
        /// 本地模式下新建角色使用的默认玩家编号，需与地块归属逻辑一致。
        /// </summary>
        public const int DefaultPlayerId = 10;
    }
}
