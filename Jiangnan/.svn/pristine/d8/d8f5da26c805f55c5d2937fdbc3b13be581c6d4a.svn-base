[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/fenglyu1314/FolderCommentTool.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "upm"]
	remote = origin
	merge = refs/heads/upm
